# =============================================================================
# Emlak CRM — ortam değişkenleri
# =============================================================================
# Bu dosya bir ŞABLONDUR ve sürüm kontrolündedir; gerçek değer içermez.
# Kopyalayıp kendi değerlerinizi girin:
#
#   cp .env.example .env.local
#
# `.env.local` `.gitignore` içinde (`.env*.local`), yani anahtarlarınız
# yanlışlıkla commit'lenmez.
#
# Değerlerin tamamı Supabase Dashboard > Project Settings > API Keys altında.
# =============================================================================

# --- Tarayıcıya AÇIK (NEXT_PUBLIC_ öneki) -----------------------------------
# Bu ikisi istemci paketine girer ve bu normaldir: anon anahtar RLS'e tabidir,
# tek başına hiçbir veriye erişim vermez.

NEXT_PUBLIC_SUPABASE_URL=https://<proje-referansi>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable anahtar>

# --- YALNIZCA SUNUCU --------------------------------------------------------
# ⚠️  Bu anahtar RLS'in TAMAMINI atlar. Asla `NEXT_PUBLIC_` öneki verilmemeli
#     ve asla bir istemci bileşeninden okunmamalı.
#
# Uygulamada iki yerde kullanılıyor:
#   · lib/supabase/admin.ts — personel daveti (Auth Admin API), `server-only`
#   · scripts/seed-supabase.ts — demo veri yazımı (RLS'siz çalışması gerekiyor)
#
# Vercel'e deploy ederken bunu "Environment Variables" altına eklemeyi
# unutmayın; eksikse davet akışı çalışmaz (uygulamanın geri kalanı çalışır).

SUPABASE_SECRET_KEY=<secret / service_role anahtar>

# --- İsteğe bağlı -----------------------------------------------------------
# Şema tiplerini yeniden üretmek için (`npm run gen:types`). Supabase kişisel
# erişim jetonu: supabase.com/dashboard/account/tokens
# Kurulmazsa proje yine çalışır — types/supabase.ts elle bakımlı.

# SUPABASE_ACCESS_TOKEN=<kisisel erisim jetonu>
